# ==============================================================================
# CONECTA EXPRESS | SISTEMA INTEGRAL DE GESTIÓN LOGÍSTICA (TMS + WMS)
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# 1. BASE DE DATOS POSTGRESQL
# Si DATABASE_URL está definida (ej. Supabase o PostgreSQL dedicado), el sistema se
# conecta mediante el driver nativo 'pg'.
# Si DATABASE_URL está vacía, el sistema utiliza el motor PostgreSQL 16 embebido
# persistente en disco en PGLITE_DATA_DIR (./data/postgres-conecta).
DATABASE_URL=
PGLITE_DATA_DIR=./data/postgres-conecta

# 2. SEGURIDAD Y SESIONES
# Clave secreta de mínimo 32 caracteres para firma HMAC-SHA256 de sesiones HTTP-Only
AUTH_SESSION_SECRET=conecta_express_enterprise_hmac_secret_2026_production_key
AUTH_SESSION_TTL_HOURS=12

# 3. IDENTIFICACIÓN INTERNA Y RÓTULOS CONECTA EXPRESS
CE_INTERNAL_LABEL_PREFIX=CE
CE_DEFAULT_LABEL_FORMAT=4X6

# 4. ADAPTADOR DE INTEGRACIÓN: PLATAFORMA ACTUAL Y COORDINADORA (MÓDULO 12)
# IMPORTANTE: Nunca almacenar credenciales reales en el código fuente.
# Modos soportados: CONTINGENCIA_CSV | API_ACTIVA | MANUAL
COORDINADORA_INTEGRATION_MODE=CONTINGENCIA_CSV
COORDINADORA_API_URL=
COORDINADORA_API_KEY=
COORDINADORA_API_USER=
COORDINADORA_NIT_ALIADO=
PLATAFORMA_GUIAS_CE_API_URL=
PLATAFORMA_GUIAS_CE_API_TOKEN=

# 5. ALMACENAMIENTO DE EVIDENCIAS (FOTOS, FIRMAS, DOCUMENTOS)
STORAGE_PROVIDER=LOCAL_DISK
STORAGE_LOCAL_PATH=./data/storage
# Para S3 / Supabase Storage en producción:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=conecta-evidencias

# 6. NOTIFICACIONES (EMAIL Y CONECTOR FUTURO WHATSAPP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=operaciones@conectaexpress.co
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
